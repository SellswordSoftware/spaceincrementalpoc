{
  "name": "eyes-on-the-universe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "format": "vp fmt",
    "build": "npm run typecheck && vp build",
    "preview": "vp preview",
    "test": "node --test test/core.test.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/web": "0.0.359",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.12.0",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0"
